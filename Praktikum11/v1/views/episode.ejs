<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>PlauderEcke</title>
    <link rel="stylesheet" type="text/css" href="/css/style.css" />
    <link rel="stylesheet" type="text/css" href="/css/flex.css"/>
</head>

<body> 
    <%- include("header") %>
    <div class="episoden">
        <main>
            <h2> <%= pod.titel %> </h2>
            <section class="episode">
                <p> Veröffentlicht am: <%= ep.datum %> </p>
                <h2> <%= ep.titel %> </h2>
                <p> <%= ep.beschreibung %> </p>
                <p>Abspielen:
                    <% for(let audio in ep.audio) {
                        <audio controls>
                            <source src="<%= audio.url %>" type="<%= audio.typ %>">
                            Ihr Browser unterstützt das Audio-Element nicht.
                        </audio>
                    <% } %>
                </p>
            </section>
        </main>
        <%- include("neuerscheinungen") %>
    </div>
    <%- include("footer") %>
</body>
</html>